# Angel One SmartAPI credentials
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_password_here
ANGEL_TOTP_SECRET=your_totp_secret_base32_here

# Firebase Admin SDK (paste the JSON string or path to service account file)
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Server
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# Broadcast interval (ms) — how often changed prices are pushed to clients
BROADCAST_INTERVAL_MS=1000

# Market hours (IST — Asia/Kolkata)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30
